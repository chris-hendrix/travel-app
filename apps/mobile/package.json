{
  "name": "@journiful/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint --config ../../eslint.config.js .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "rm -rf .expo dist node_modules",
    "export:web": "expo export --platform web --clear",
    "serve:web": "node scripts/serve-static.mjs",
    "gen:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/big-shoulders-display": "0.2.3",
    "@expo-google-fonts/bungee-shade": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@journiful/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "libphonenumber-js": "^1.13.14",
    "linkifyjs": "^4.3.3",
    "lucide-react-native": "^1.59.0",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "^0.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "^19.1.0",
    "expo-doctor": "^1.21.5",
    "lightningcss": "1.30.1",
