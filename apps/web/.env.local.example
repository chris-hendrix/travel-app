# ===========================================
# Frontend Environment Variables (Next.js)
# ===========================================
#
# Copy this file to .env.local and customize values as needed:
#   cp .env.local.example .env.local
#
# IMPORTANT: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Do NOT use NEXT_PUBLIC_ prefix for sensitive values like API keys or secrets.
#
# For more info: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# ===========================================
# API Configuration
# ===========================================

# Backend API Base URL
# This is the URL where your Next.js frontend will send API requests.
# The NEXT_PUBLIC_ prefix makes this variable accessible in browser code.
#
# Development (default):
NEXT_PUBLIC_API_URL=http://localhost:8000/api
#
# Android emulator: localhost in the emulator is the emulator itself, NOT the host.
# Use `make adb-reverse` before running the emulator so emulator's localhost:8000
# forwards to the host, making this default URL work. See AGENTS.md > Native.
#
# When building a production APK, set this to your production API URL:
# NEXT_PUBLIC_API_URL=https://api.journiful.app/api

# Server-side API URL (for RSC server-side data fetching)
# This is NOT exposed to the browser - used only by Next.js server components.
# In production, this may point to an internal/private API endpoint.
API_URL=http://localhost:8000/api

# ===========================================
# Site URL Configuration
# ===========================================

# Public site URL used for SEO (robots.txt, sitemap.xml)
# In production, set to your actual domain (e.g., https://journiful.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Optional: Additional Frontend Configuration
# ===========================================

# Uncomment and configure these as your application grows:

# VAPID Public Key for Web Push Notifications
# Must match the VAPID_PUBLIC_KEY in the API .env
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Capacitor Live Reload (required — for Android emulator dev)
# Set to "true" to serve the Capacitor app from the Next.js dev server
# at http://10.0.2.2:3000 instead of bundled static assets.
# Required: pnpm dev (or make dev) running on the host.
CAPACITOR_LIVE_RELOAD=true

# Feature Flags (if needed)
# NEXT_PUBLIC_ENABLE_POLLING=true          # Set to "false" to disable TanStack Query polling
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_DEBUG_MODE=false

# External Services (if integrated)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# App Configuration
# NEXT_PUBLIC_APP_NAME=Journiful
# NEXT_PUBLIC_APP_URL=http://localhost:3000
