{
  "name": "@journiful/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm docker:up && turbo run dev",
    "dev:web": "turbo run dev --filter=@journiful/web",
    "dev:api": "turbo run dev --filter=@journiful/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@journiful/web",
    "build:api": "turbo run build --filter=@journiful/api",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter=@journiful/web test:e2e",
    "test:e2e:ui": "pnpm --filter=@journiful/web test:e2e:ui",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker-compose up -d postgres minio minio-init",
    "docker:down": "docker-compose down",
    "docker:restart": "docker-compose up -d postgres minio minio-init",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@firebase/util",
      "protobufjs"
    ],
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "fast-jwt": ">=6.2.4",
      "fast-uri": ">=3.1.2",
      "fast-xml-builder": ">=1.1.7",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": ">=7.29.4",
      "axios": ">=1.16.0",
      "form-data@>=4.0.0": ">=4.0.6",
      "form-data@<3.0.0": ">=2.5.6 <3.0.0",
      "vite": ">=8.0.16",
      "undici": ">=7.28.0"
    }
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
