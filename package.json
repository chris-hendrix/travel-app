{
  "name": "@journiful/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm docker:up && turbo run dev",
    "dev:web": "turbo run dev --filter=@journiful/web",
    "dev:api": "turbo run dev --filter=@journiful/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@journiful/web",
    "build:api": "turbo run build --filter=@journiful/api",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter=@journiful/web test:e2e",
    "test:e2e:ui": "pnpm --filter=@journiful/web test:e2e:ui",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker-compose up -d postgres minio minio-init",
    "docker:down": "docker-compose down",
    "docker:restart": "docker-compose up -d postgres minio minio-init",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@firebase/util",
      "protobufjs"
    ],
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "fast-jwt": ">=6.2.4",
      "fast-uri": ">=4.1.2",
      "find-my-way": ">=9.7.0",
      "fast-xml-builder": ">=1.1.7",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": ">=7.29.4",
      "axios": ">=1.16.0",
      "form-data@>=4.0.0": ">=4.0.6",
      "form-data@<3.0.0": ">=2.5.6 <3.0.0",
      "vite": ">=8.2.0",
      "typescript": "^7.0.2",
      "undici": "^7.28.0",
      "postcss": ">=8.5.18",
      "brace-expansion@<1.1.17": ">=1.1.17",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "sharp": ">=0.35.0"
    }
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
